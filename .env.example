# LexorA Environment Variables
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here-generate-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DATABASE_URL=sqlite:///lexora.db

# Google OAuth (REQUIRED - Primary Login Method)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_URL=https://your-app-url.com

# Twilio for SMS OTP (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid for Email (Optional)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@lexora.com
SENDGRID_FROM_NAME=LexorA

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_HTTPONLY=True
SESSION_SAMESITE=Lax
